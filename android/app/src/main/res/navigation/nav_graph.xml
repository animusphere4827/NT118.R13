<?xml version="1.0" encoding="utf-8"?>
<!--
    Flow được khai báo trực tiếp trên layout bằng android:tag:
      nav:<màn_hình>   mở màn hình đó        back   quay lại
      password:<id>    ẩn/hiện mật khẩu      pick:<nhóm>  chọn một trong nhóm
      show:<id> / hide:<id>  hiện/ẩn view    check:<nhóm>:<đúng>:<màn_đúng>:<màn_sai>
      navtab:<tab>     (trên bottomNavHost) tab đang chọn của thanh điều hướng dưới
    Mọi màn hình dùng chung ScreenFragment; layout chọn qua argument "layout".
-->
