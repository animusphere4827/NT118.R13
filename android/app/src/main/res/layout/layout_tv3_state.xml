<?xml version="1.0" encoding="utf-8"?>
<!-- Trạng thái tải / lỗi / rỗng dùng chung cho Trang chủ và Lộ trình -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/stateLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/app_primary" />
        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tv3_loading" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stateMessage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/stateIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_wifi_off"
            android:tint="@color/app_text_secondary" />
        <TextView
            android:id="@+id/stateText"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center" />
        <TextView
            android:id="@+id/stateRetry"
            style="@style/Button.Outline"
            android:layout_width="160dp"
            android:layout_marginTop="16dp"
            android:text="@string/tv3_retry" />
    </LinearLayout>
</FrameLayout>
