<?xml version="1.0" encoding="utf-8"?>
<!-- Đọc một bài báo tiếng Anh lấy từ RSS: ảnh, tiêu đề, đoạn tóm tắt (chạm từ để tra nghĩa), link bài gốc -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_marginStart="8dp"
                style="@style/IconButton"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/app_text_secondary"
                android:contentDescription="@string/register_13" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/news_screen_title" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="120dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/imgCover"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:background="@drawable/bg_card"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/txtCredit"
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/txtMeta"
                    android:layout_marginTop="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/app_primary"
                    android:textStyle="bold"
                    style="@style/Text.Caption" />
                <TextView
                    android:id="@+id/txtTitle"
                    android:textSize="22sp"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Title" />
                <TextView
                    android:id="@+id/txtHint"
                    android:layout_marginTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption"
                    android:text="@string/news_tap_hint" />
                <TextView
                    android:id="@+id/txtSummary"
                    android:layout_marginTop="14dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card"
                    android:fontFamily="serif"
                    android:textSize="17sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/app_text"
                    android:textIsSelectable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption" />
                <TextView
                    android:id="@+id/btnOpenSource"
                    android:layout_marginTop="12dp"
                    style="@style/Button.Outline"
                    android:text="@string/news_open_source" />
                <TextView
                    android:id="@+id/txtAttribution"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <LinearLayout
        android:background="@drawable/bg_sheet"
        android:padding="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/lookupSheet"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_dot" />
        <LinearLayout
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/txtWord"
                android:textSize="24sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:layout_height="wrap_content"
                style="@style/Text.Heading"
                android:text="@string/intro2_07" />
            <ImageButton
                android:id="@+id/btnSpeak"
                android:layout_width="32dp"
                android:layout_height="32dp"
                style="@style/IconButton"
                android:src="@drawable/ic_volume"
                app:tint="@color/app_primary"
                android:contentDescription="@string/reading_article_14" />
            <ImageButton
                android:layout_width="32dp"
                android:layout_height="32dp"
                style="@style/IconButton"
                android:src="@drawable/ic_x"
                app:tint="@color/app_text_secondary"
                android:id="@+id/btnCloseSheet"
                android:contentDescription="@string/flashcard_front_08" />
        </LinearLayout>
        <TextView
            android:id="@+id/txtIpa"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.Caption"
            android:text="@string/flashcard_front_02" />
        <TextView
            android:id="@+id/txtMeaning"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.Body"
            android:text="@string/reading_article_15" />
        <TextView
            android:id="@+id/txtExample"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.Caption"
            android:text="@string/reading_article_16" />
        <LinearLayout
            android:id="@+id/btnSaveCard"
            android:layout_marginTop="16dp"
            style="@style/Button.Primary"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plus"
                app:tint="@color/white"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_marginStart="8dp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.Body"
                android:text="@string/reading_article_10" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
