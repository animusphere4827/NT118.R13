<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:layout_marginStart="8dp"
                style="@style/IconButton"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/app_text_secondary"
                android:id="@+id/btnBack"
                android:contentDescription="@string/register_13" />
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/stats_29" />
            <ImageButton
                android:id="@+id/btnHistory"
                style="@style/IconButton"
                android:src="@drawable/ic_calendar"
                app:tint="@color/app_text_secondary"
                android:contentDescription="@string/stats_28" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_marginTop="0dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_big"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/txtActivityTitle"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            style="@style/Text.Body"
                            android:text="@string/stats_activity" />
                        <TextView
                            android:id="@+id/txtActivityRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Link"
                            android:text="@string/stats_last_7_days" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="bottom"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/txtActivityTotal"
                            android:textSize="32sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Heading"
                            android:text="@string/stats_12" />
                        <TextView
                            android:id="@+id/txtActivityUnit"
                            android:layout_marginStart="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/stats_activity_unit" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/barRow"
                        android:gravity="bottom"
                        android:layout_marginTop="12dp"
                        android:layout_height="130dp"
                        android:layout_width="match_parent"
                        android:orientation="horizontal" />
                    <TextView
                        android:id="@+id/txtStreak"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_big"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/txtPartTitle"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            style="@style/Text.Body"
                            android:text="@string/stats_by_part" />
                        <TextView
                            android:id="@+id/txtOverall"
                            android:textColor="@color/app_teal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Link"
                            android:text="@string/home_11" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/partBars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <TextView
                        android:id="@+id/txtScoreNote"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/stats_20" />
                </LinearLayout>
                <TextView
                    android:id="@+id/txtWeakTitle"
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Title"
                    android:text="@string/stats_21" />
                <LinearLayout
                    android:id="@+id/weakList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/btnMistakes"
                    android:layout_marginTop="24dp"
                    style="@style/Button.Primary"
                    android:text="@string/stats_review_mistakes" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
