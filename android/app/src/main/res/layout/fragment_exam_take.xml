<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:layout_marginStart="8dp"
                style="@style/IconButton"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/app_text_secondary"
                android:id="@+id/btnBack"
                android:tag="back"
                android:contentDescription="@string/register_13" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/exam_take_18" />
            <ImageButton
                style="@style/IconButton"
                android:src="@drawable/ic_flag"
                android:tint="@color/app_text_secondary"
                android:contentDescription="@string/exam_take_17" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/Badge"
                        android:text="@string/quiz_part5_05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginStart="8dp"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/exam_take_10" />
                </LinearLayout>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:progress="23"
                    android:max="100"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"
                    app:indicatorColor="@color/app_primary"
                    app:trackColor="@color/app_border" />
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_big"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/exam_take_11" />
                    <TextView
                        android:fontFamily="serif"
                        android:textStyle="normal"
                        android:textSize="18sp"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Title"
                        android:text="@string/quiz_part5_07" />
                </LinearLayout>
                <LinearLayout
                    android:background="@drawable/bg_option_pick"
                    android:padding="14dp"
                    android:layout_marginTop="8dp"
                    android:minHeight="52dp"
                    android:tag="pick:eq"
                    android:id="@+id/optA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:textColor="@color/app_text_secondary"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/intro2_04" />
                    <TextView
                        android:layout_marginStart="12dp"
                        android:fontFamily="serif"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/intro2_05" />
                </LinearLayout>
                <LinearLayout
                    android:background="@drawable/bg_option_pick"
                    android:padding="14dp"
                    android:layout_marginTop="8dp"
                    android:minHeight="52dp"
                    android:tag="pick:eq*"
                    android:id="@+id/optB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:textColor="@color/app_text_secondary"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/intro2_06" />
                    <TextView
                        android:layout_marginStart="12dp"
                        android:fontFamily="serif"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/intro2_07" />
                </LinearLayout>
                <LinearLayout
                    android:background="@drawable/bg_option_pick"
                    android:padding="14dp"
                    android:layout_marginTop="8dp"
                    android:minHeight="52dp"
                    android:tag="pick:eq"
                    android:id="@+id/optC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:textColor="@color/app_text_secondary"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/quiz_part5_01" />
                    <TextView
                        android:layout_marginStart="12dp"
                        android:fontFamily="serif"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/quiz_part5_02" />
                </LinearLayout>
                <LinearLayout
                    android:background="@drawable/bg_option_pick"
                    android:padding="14dp"
                    android:layout_marginTop="8dp"
                    android:minHeight="52dp"
                    android:tag="pick:eq"
                    android:id="@+id/optD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:textColor="@color/app_text_secondary"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/quiz_part5_03" />
                    <TextView
                        android:layout_marginStart="12dp"
                        android:fontFamily="serif"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/quiz_part5_04" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/exam_take_12" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/app_text_secondary"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:background="@drawable/bg_cell_done"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:layout_marginStart="0dp"
                        android:textColor="@color/app_text"
                        style="@style/Text.Body"
                        android:text="@string/exam_take_01" />
                    <TextView
                        android:background="@drawable/bg_cell_done"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/app_text"
                        style="@style/Text.Body"
                        android:text="@string/exam_take_02" />
                    <TextView
                        android:background="@drawable/bg_cell_done"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/app_text"
                        style="@style/Text.Body"
                        android:text="@string/exam_take_03" />
                    <TextView
                        android:background="@drawable/bg_cell_current"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        style="@style/Text.Body"
                        android:text="@string/deck_detail_03" />
                    <TextView
                        android:background="@drawable/bg_cell"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/app_text"
                        style="@style/Text.Body"
                        android:text="@string/exam_take_04" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:background="@drawable/bg_cell"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:layout_marginStart="0dp"
                        android:textColor="@color/app_text"
                        style="@style/Text.Body"
                        android:text="@string/exam_take_05" />
                    <TextView
                        android:background="@drawable/bg_cell"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/app_text"
                        style="@style/Text.Body"
                        android:text="@string/exam_take_06" />
                    <TextView
                        android:background="@drawable/bg_cell"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/app_text"
                        style="@style/Text.Body"
                        android:text="@string/exam_take_07" />
                    <TextView
                        android:background="@drawable/bg_cell"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/app_text"
                        style="@style/Text.Body"
                        android:text="@string/exam_take_08" />
                    <TextView
                        android:background="@drawable/bg_cell"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/app_text"
                        style="@style/Text.Body"
                        android:text="@string/exam_take_09" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Link"
                        android:text="@string/exam_take_13" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/exam_take_14" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/exam_take_15" />
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView
                    android:layout_marginTop="16dp"
                    style="@style/Button.Primary"
                    android:text="@string/exam_take_16"
                    android:tag="nav:exam_result" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
