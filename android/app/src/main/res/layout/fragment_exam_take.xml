<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:layout_marginStart="8dp"
                style="@style/IconButton"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/app_text_secondary"
                android:id="@+id/btnBack"
                android:contentDescription="@string/register_13" />
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                style="@style/Text.Title" />
            <ImageButton
                android:id="@+id/btnFlag"
                style="@style/IconButton"
                android:src="@drawable/ic_flag"
                app:tint="@color/app_text_secondary"
                android:contentDescription="@string/exam_take_17" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/txtPart"
                        style="@style/Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/txtAnswered"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginStart="8dp"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption" />
                </LinearLayout>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"
                    app:indicatorColor="@color/app_primary"
                    app:trackColor="@color/app_border" />
                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption" />
                <LinearLayout
                    android:id="@+id/passageBox"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_big"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption" />
                    <TextView
                        android:id="@+id/txtQuestion"
                        android:fontFamily="serif"
                        android:textStyle="normal"
                        android:textSize="18sp"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Title" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/optionList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <LinearLayout
                    android:id="@+id/btnBlock"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:id="@+id/txtBlock"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/app_text_secondary"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/gridBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <LinearLayout
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/btnPrev"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:layout_height="wrap_content"
                        android:text="@string/assess_prev"
                        style="@style/Text.Link" />
                    <TextView
                        android:id="@+id/txtLegend"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption" />
                    <TextView
                        android:id="@+id/btnNext"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:gravity="center_vertical|end"
                        android:layout_height="wrap_content"
                        android:text="@string/assess_next"
                        style="@style/Text.Link" />
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/btnSubmit"
                    android:layout_marginTop="16dp"
                    style="@style/Button.Primary"
                    android:text="@string/exam_take_16" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
