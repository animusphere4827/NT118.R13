<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavHost"
        android:orientation="vertical">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/learn_path_14" />
            <ImageButton
                style="@style/IconButton"
                android:src="@drawable/ic_circle_help"
                android:tint="@color/app_text_secondary"
                android:contentDescription="@string/learn_path_13" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textSize="20sp"
                        android:layout_height="wrap_content"
                        style="@style/Text.Title"
                        android:text="@string/learn_path_01" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/learn_path_02" />
                </LinearLayout>
                <LinearLayout
                    android:background="@drawable/bg_panel"
                    android:padding="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textColor="@color/app_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Link"
                        android:text="@string/learn_path_03" />
                    <TextView
                        android:layout_marginTop="2dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/learn_path_04" />
                </LinearLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_gravity="start"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_success">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:tint="@color/white"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:layout_marginTop="4dp"
                            android:layout_width="120dp"
                            android:textStyle="normal"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/learn_path_05" />
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_gravity="end"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_success">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                android:tint="@color/white"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:layout_marginTop="4dp"
                            android:layout_width="120dp"
                            android:textStyle="normal"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/learn_path_06" />
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_gravity="start"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="nav:flashcard_front"
                        android:foreground="?attr/selectableItemBackground">
                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_primary">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_play"
                                android:tint="@color/white"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:layout_marginTop="4dp"
                            android:layout_width="120dp"
                            android:textStyle="bold"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/learn_path_07" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textColor="@color/app_teal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Link"
                        android:text="@string/learn_path_08" />
                    <TextView
                        android:layout_marginTop="2dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/learn_path_09" />
                </LinearLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_gravity="end"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_neutral">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_lock"
                                android:tint="@color/app_text_secondary"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:layout_marginTop="4dp"
                            android:layout_width="120dp"
                            android:textStyle="normal"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/learn_path_10" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:tag="nav:reading_list"
                    android:foreground="?attr/selectableItemBackground">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_square">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_file_text"
                            android:tint="@color/app_primary"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Body"
                            android:text="@string/learn_path_11" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/learn_path_12" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/app_text_secondary"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/bottomNavHost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:tag="navtab:learn_path"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <include
            layout="@layout/layout_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
