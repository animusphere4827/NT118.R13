<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_marginTop="12dp"
    android:padding="16dp"
    android:background="@drawable/bg_card_big"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txtNumber"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            style="@style/Text.Caption" />
        <TextView
            android:id="@+id/txtType"
            style="@style/Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView
        android:id="@+id/txtPassage"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:visibility="gone"
        style="@style/Text.Caption" />
    <TextView
        android:id="@+id/txtQuestion"
        android:fontFamily="serif"
        android:textStyle="normal"
        android:textSize="17sp"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.Title" />
    <LinearLayout
        android:id="@+id/rowChosen"
        android:background="@drawable/bg_option_wrong"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        android:minHeight="52dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txtChosenLabel"
            android:textColor="@color/app_text_secondary"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.Caption" />
        <TextView
            android:id="@+id/txtChosenText"
            android:layout_marginStart="12dp"
            android:fontFamily="serif"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Text.Body" />
        <TextView
            android:id="@+id/txtChosenNote"
            android:textColor="@color/app_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.Caption"
            android:text="@string/exam_review_04" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rowCorrect"
        android:background="@drawable/bg_option_correct"
        android:padding="14dp"
        android:layout_marginTop="8dp"
        android:minHeight="52dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txtCorrectLabel"
            android:textColor="@color/app_text_secondary"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.Caption" />
        <TextView
            android:id="@+id/txtCorrectText"
            android:layout_marginStart="12dp"
            android:fontFamily="serif"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Text.Body" />
        <TextView
            android:textColor="@color/app_success"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.Caption"
            android:text="@string/exam_review_06" />
    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txtOthers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.Caption" />
    </LinearLayout>
    <TextView
        android:id="@+id/txtWhy"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.Body" />
    <TextView
        android:id="@+id/txtExplain"
        android:layout_marginTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.Caption" />
    <TextView
        android:id="@+id/txtTranslation"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.Caption" />
</LinearLayout>
