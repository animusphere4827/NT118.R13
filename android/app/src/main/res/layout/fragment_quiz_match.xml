<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:layout_marginStart="8dp"
                style="@style/IconButton"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/app_text_secondary"
                android:id="@+id/btnBack"
                android:tag="back"
                android:contentDescription="@string/register_13" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/quiz_match_06" />
            <ImageButton
                style="@style/IconButton"
                android:src="@drawable/ic_x"
                android:tint="@color/app_text_secondary"
                android:tag="nav:reading_list"
                android:contentDescription="@string/flashcard_front_08" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/Badge"
                        android:text="@string/quiz_match_01"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginStart="8dp"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/quiz_match_02" />
                </LinearLayout>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:progress="50"
                    android:max="100"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"
                    app:indicatorColor="@color/app_primary"
                    app:trackColor="@color/app_border" />
                <TextView
                    android:textSize="26sp"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Heading"
                    android:text="@string/quiz_match_03" />
                <TextView
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption"
                    android:text="@string/quiz_match_04" />
                <LinearLayout
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:fontFamily="serif"
                        android:background="@drawable/bg_option_correct"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/intro2_07"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="pick:m" />
                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />
                    <TextView
                        android:fontFamily="sans-serif"
                        android:background="@drawable/bg_option_correct"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/flashcard_back_02"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="pick:m" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:fontFamily="serif"
                        android:background="@drawable/bg_option_pick"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/deck_detail_08"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="pick:m" />
                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />
                    <TextView
                        android:fontFamily="sans-serif"
                        android:background="@drawable/bg_option_pick"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/deck_detail_11"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="pick:m" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:fontFamily="serif"
                        android:background="@drawable/bg_option_pick"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/deck_detail_10"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="pick:m" />
                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />
                    <TextView
                        android:fontFamily="sans-serif"
                        android:background="@drawable/bg_option_pick"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/deck_detail_09"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="pick:m" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:fontFamily="serif"
                        android:background="@drawable/bg_option_pick"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/deck_detail_12"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="pick:m" />
                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />
                    <TextView
                        android:fontFamily="sans-serif"
                        android:background="@drawable/bg_option_pick"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/deck_detail_18"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="pick:m" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:fontFamily="serif"
                        android:background="@drawable/bg_option_pick"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/deck_detail_17"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="pick:m" />
                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />
                    <TextView
                        android:fontFamily="sans-serif"
                        android:background="@drawable/bg_option_pick"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/deck_detail_13"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="pick:m" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_circle_check"
                        android:tint="@color/app_teal"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_marginStart="8dp"
                        android:textColor="@color/app_teal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/quiz_match_05" />
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView
                    android:layout_marginTop="24dp"
                    style="@style/Button.Primary"
                    android:text="@string/quiz_part5_09"
                    android:tag="nav:quiz_order" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
