<?xml version="1.0" encoding="utf-8"?>
<!--
    Phiên lật thẻ: gộp hai frame Figma "Flashcard: mặt trước" (fragment_flashcard_front)
    và "Flashcard: mặt sau" (fragment_flashcard_back) để lật bằng animation trong cùng một màn.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Thanh tiêu đề -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/btnBack"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/register_13"
                android:src="@drawable/ic_arrow_left" />
            <TextView
                android:id="@+id/txtTitle"
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/flashcard_front_09" />
            <ImageButton
                android:id="@+id/btnAutoPlay"
                style="@style/IconButton"
                android:contentDescription="@string/flash_autoplay"
                android:src="@drawable/ic_play" />
            <ImageButton
                android:id="@+id/btnClose"
                style="@style/IconButton"
                android:contentDescription="@string/flashcard_front_08"
                android:src="@drawable/ic_x" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/txtMode"
                        style="@style/Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/flashcard_front_04"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtCounter"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flashcard_front_05" />
                </LinearLayout>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    app:indicatorColor="@color/app_primary"
                    app:trackColor="@color/app_border"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp" />

                <!-- Thẻ: hai mặt chồng lên nhau, lật quanh trục Y; vuốt trái/phải để chấm -->
                <FrameLayout
                    android:id="@+id/cardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="420dp"
                    android:layout_marginTop="12dp">

                    <!-- Mặt trước (Figma: Flashcard mặt trước) -->
                    <LinearLayout
                        android:id="@+id/faceFront"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_big"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/txtDeckLabel"
                                style="@style/Text.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/flashcard_front_01" />
                            <ImageView
                                android:id="@+id/imgPinned"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_bookmark"
                                android:tint="@color/app_text_secondary" />
                        </LinearLayout>
                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <ImageView
                            android:id="@+id/imgCard"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_marginBottom="12dp"
                            android:contentDescription="@string/card_image_label"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />
                        <TextView
                            android:id="@+id/txtFrontWord"
                            style="@style/Text.Heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/intro2_07"
                            android:textSize="32sp" />
                        <TextView
                            android:id="@+id/txtFrontIpa"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/flashcard_front_02"
                            android:textColor="@color/app_text_secondary" />
                        <ImageButton
                            android:id="@+id/btnSpeakFront"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_circle_soft"
                            android:contentDescription="@string/flash_speak"
                            android:src="@drawable/ic_volume"
                            android:tint="@color/app_primary" />
                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/flashcard_front_03" />
                    </LinearLayout>

                    <!-- Mặt sau (Figma: Flashcard mặt sau) -->
                    <ScrollView
                        android:id="@+id/faceBack"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_big"
                        android:visibility="gone">
                        <LinearLayout
                            android:id="@+id/faceBackContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="20dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/txtBackWord"
                                    style="@style/Text.Heading"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/intro2_07"
                                    android:textSize="28sp" />
                                <ImageButton
                                    android:id="@+id/btnSpeakBack"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/flash_speak"
                                    android:src="@drawable/ic_volume"
                                    android:tint="@color/app_primary" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtBackIpa"
                                style="@style/Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/flashcard_front_02" />
                            <TextView
                                style="@style/Text.Label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/flash_meaning_label" />
                            <TextView
                                android:id="@+id/txtMeaning"
                                style="@style/Text.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/flashcard_back_02"
                                android:textColor="@color/app_primary" />
                            <View
                                android:id="@+id/dividerExample"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:background="@color/app_border" />
                            <TextView
                                android:id="@+id/txtExample"
                                style="@style/Text.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:text="@string/flashcard_back_03"
                                android:textSize="17sp" />
                            <TextView
                                android:id="@+id/txtNote"
                                style="@style/Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/flashcard_back_04" />
                        </LinearLayout>
                    </ScrollView>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/txtRemaining"
                        style="@style/Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/flashcard_front_06" />
                    <ImageButton
                        android:id="@+id/btnFlipIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/flashcard_front_03"
                        android:src="@drawable/ic_rotate_ccw"
                        android:tint="@color/app_text_secondary" />
                </LinearLayout>

                <!-- Hoàn thành phiên ôn -->
                <LinearLayout
                    android:id="@+id/groupDone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_panel_ok"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/txtDoneTitle"
                        style="@style/Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/flash_done_title"
                        android:textColor="@color/app_success" />
                    <TextView
                        android:id="@+id/txtDoneDesc"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/app_text" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Nút mặt trước -->
                <LinearLayout
                    android:id="@+id/groupFrontActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/btnFlip"
                        style="@style/Button.Primary"
                        android:layout_marginTop="16dp"
                        android:text="@string/flashcard_front_03" />
                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/flashcard_front_07" />
                </LinearLayout>

                <!-- Nút mặt sau -->
                <LinearLayout
                    android:id="@+id/groupBackActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/flashcard_back_06" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/btnAgain"
                            style="@style/Button.Outline"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/flashcard_back_07" />
                        <TextView
                            android:id="@+id/btnKnown"
                            style="@style/Button.Primary"
                            android:layout_width="0dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/flashcard_back_08" />
                    </LinearLayout>
                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/flashcard_back_09" />
                </LinearLayout>

                <!-- Nút khi đã ôn hết -->
                <TextView
                    android:id="@+id/btnFinish"
                    style="@style/Button.Primary"
                    android:layout_marginTop="16dp"
                    android:text="@string/flash_finish"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
