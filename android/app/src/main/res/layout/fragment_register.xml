<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:layout_marginStart="8dp"
                style="@style/IconButton"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/app_text_secondary"
                android:id="@+id/btnBack"
                android:contentDescription="@string/register_13" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/register_09" />
            <ImageButton
                style="@style/IconButton"
                android:src="@drawable/ic_ellipsis"
                android:tint="@color/app_text_secondary"
                android:contentDescription="@string/register_12" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:textSize="28sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Heading"
                    android:text="@string/register_03" />
                <TextView
                    android:layout_marginTop="8dp"
                    android:textColor="@color/app_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/register_04" />
                <TextView
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Label"
                    android:text="@string/register_05" />
                <LinearLayout
                    style="@style/Field"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_user"
                        android:tint="@color/app_text_secondary"
                        android:importantForAccessibility="no" />
                    <EditText
                        style="@style/Field.Input"
                        android:hint="@string/register_05"
                        android:inputType="textPersonName"
                        android:id="@+id/edtName" />
                </LinearLayout>
                <TextView
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Label"
                    android:text="@string/register_06" />
                <LinearLayout
                    style="@style/Field"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field_ok">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_mail"
                        android:tint="@color/app_text_secondary"
                        android:importantForAccessibility="no" />
                    <EditText
                        style="@style/Field.Input"
                        android:hint="@string/register_06"
                        android:inputType="textEmailAddress"
                        android:id="@+id/edtEmail" />
                </LinearLayout>
                <TextView
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Label"
                    android:text="@string/register_02" />
                <LinearLayout
                    style="@style/Field"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock"
                        android:tint="@color/app_text_secondary"
                        android:importantForAccessibility="no" />
                    <EditText
                        style="@style/Field.Input"
                        android:hint="@string/register_02"
                        android:inputType="textPassword"
                        android:id="@+id/edtPassword" />
                    <ImageButton
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        style="@style/IconButton"
                        android:src="@drawable/ic_eye"
                        android:tint="@color/app_text_secondary"
                        android:id="@+id/btnTogglePassword"
                        android:contentDescription="@string/register_01" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:id="@+id/strength1"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:background="@color/app_success" />
                    <View
                        android:id="@+id/strength2"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@color/app_success" />
                    <View
                        android:id="@+id/strength3"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@color/app_success" />
                    <View
                        android:id="@+id/strength4"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@color/app_border" />
                </LinearLayout>
                <TextView
                    android:id="@+id/txtStrength"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/app_success"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption"
                    android:text="@string/register_07" />
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <CheckBox
                        android:id="@+id/chkTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="true"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/register_08" />
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView
                    android:layout_marginTop="24dp"
                    style="@style/Button.Primary"
                    android:id="@+id/btnRegister"
                    android:text="@string/register_09" />
                <LinearLayout
                    android:layout_marginTop="8dp"
                    android:id="@+id/btnGoogle"
                    style="@style/Button.Outline"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_user_circle"
                        android:tint="@color/app_primary"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_marginStart="8dp"
                        android:textColor="@color/app_primary"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/register_10" />
                </LinearLayout>
                <TextView
                    android:layout_marginTop="8dp"
                    style="@style/Button.Text"
                    android:id="@+id/btnToLogin"
                    android:text="@string/register_11" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
