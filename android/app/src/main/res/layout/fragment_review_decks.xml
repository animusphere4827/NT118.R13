<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavHost"
        android:orientation="vertical">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/review_decks_16" />
            <ImageButton
                android:id="@+id/btnSort"
                style="@style/IconButton"
                android:src="@drawable/ic_sliders"
                android:tint="@color/app_text_secondary"
                android:contentDescription="@string/review_decks_15" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/panelQuick"
                    android:background="@drawable/bg_panel"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textColor="@color/app_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Link"
                        android:text="@string/review_decks_01" />
                    <LinearLayout
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/txtDueTotal"
                            android:textSize="40sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Display"
                            android:text="@string/review_decks_02" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:textStyle="bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Text.Title"
                                android:text="@string/review_decks_03" />
                            <TextView
                                android:id="@+id/txtDueHint"
                                android:layout_marginTop="2dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Text.Caption"
                                android:text="@string/review_decks_04" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:layout_marginTop="12dp"
                        style="@style/Button.Primary"
                        android:id="@+id/btnQuickReview"
                        android:text="@string/review_decks_05" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Title"
                        android:text="@string/review_decks_06" />
                    <TextView
                        android:id="@+id/txtDeckCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/review_decks_07" />
                </LinearLayout>
                <!-- Lưới 2 cột các bộ thẻ (item_deck), dữ liệu từ GET /learn/decks -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDecks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="-6dp"
                    android:layout_marginEnd="-6dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:spanCount="2"
                    tools:listitem="@layout/item_deck" />
                <include
                    android:id="@+id/state"
                    layout="@layout/view_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <!-- Chừa chỗ cho nút + nổi -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="56dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/bottomNavHost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:tag="navtab:review_decks"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <include
            layout="@layout/layout_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>
    <ImageButton
        android:id="@+id/btnAdd"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle_primary"
        android:src="@drawable/ic_plus"
        android:tint="@color/white"
        android:contentDescription="@string/review_decks_14"
        android:scaleType="center"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavHost" />
</androidx.constraintlayout.widget.ConstraintLayout>
