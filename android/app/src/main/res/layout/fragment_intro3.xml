<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/intro2_13" />
            <ImageButton
                style="@style/IconButton"
                android:src="@drawable/ic_languages"
                android:tint="@color/app_text_secondary"
                android:id="@+id/btnLang"
                android:contentDescription="@string/intro2_13" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:textColor="@color/app_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption"
                    android:text="@string/intro3_08" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />
                <LinearLayout
                    android:background="@drawable/bg_card_big"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/intro3_01" />
                    <LinearLayout
                        android:layout_marginTop="8dp"
                        android:gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Display"
                            android:text="@string/intro3_02" />
                        <TextView
                            android:layout_marginStart="4dp"
                            android:textColor="@color/app_text_secondary"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Body"
                            android:text="@string/intro3_03" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_trending_up"
                            android:tint="@color/app_teal"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_marginStart="6dp"
                            android:textColor="@color/app_teal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/intro3_04" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:layout_marginTop="8dp"
                        android:src="@drawable/chart_trend"
                        android:scaleType="fitXY"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/intro3_05" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/intro3_06" />
                    </LinearLayout>
                    <TextView
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/intro3_07" />
                </LinearLayout>
                <TextView
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Heading"
                    android:text="@string/intro3_09" />
                <TextView
                    android:layout_marginTop="12dp"
                    android:textColor="@color/app_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/intro3_10" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <LinearLayout
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="0dp"
                        android:background="@drawable/bg_dot" />
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_dot" />
                    <View
                        android:layout_width="24dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_dot_active" />
                </LinearLayout>
                <TextView
                    android:layout_marginTop="8dp"
                    style="@style/Button.Primary"
                    android:text="@string/intro3_11"
                    android:tag="nav:register" />
                <TextView
                    android:layout_marginTop="8dp"
                    style="@style/Button.Text"
                    android:text="@string/intro3_12"
                    android:tag="nav:login" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
