<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:layout_marginStart="8dp"
                style="@style/IconButton"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/app_text_secondary"
                android:id="@+id/btnBack"
                android:tag="back"
                android:contentDescription="@string/register_13" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/card_edit_09" />
            <ImageButton
                style="@style/IconButton"
                android:src="@drawable/ic_ellipsis"
                android:tint="@color/app_text_secondary"
                android:contentDescription="@string/register_12" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:textColor="@color/app_primary"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/review_decks_08" />
                    <ImageView
                        android:layout_marginStart="4dp"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/app_primary"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <TextView
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Label"
                    android:text="@string/card_edit_01" />
                <LinearLayout
                    style="@style/Field"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_languages"
                        android:tint="@color/app_text_secondary"
                        android:importantForAccessibility="no" />
                    <EditText
                        style="@style/Field.Input"
                        android:hint="@string/card_edit_01"
                        android:inputType="text"
                        android:text="@string/intro2_07"
                        android:id="@+id/edtWord" />
                </LinearLayout>
                <TextView
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Label"
                    android:text="@string/card_edit_02" />
                <LinearLayout
                    style="@style/Field"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_book_open"
                        android:tint="@color/app_text_secondary"
                        android:importantForAccessibility="no" />
                    <EditText
                        style="@style/Field.Input"
                        android:hint="@string/card_edit_02"
                        android:inputType="text"
                        android:text="@string/flashcard_back_02"
                        android:id="@+id/edtMeaning" />
                </LinearLayout>
                <TextView
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Label"
                    android:text="@string/card_edit_03" />
                <LinearLayout
                    style="@style/Field"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_quote"
                        android:tint="@color/app_text_secondary"
                        android:importantForAccessibility="no" />
                    <EditText
                        style="@style/Field.Input"
                        android:hint="@string/card_edit_03"
                        android:inputType="text"
                        android:text="@string/flashcard_back_03"
                        android:id="@+id/edtExample" />
                </LinearLayout>
                <LinearLayout
                    android:background="@drawable/bg_panel"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lightbulb"
                        android:tint="@color/app_primary"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Body"
                            android:text="@string/card_edit_04" />
                        <TextView
                            android:layout_marginTop="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/card_edit_05" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption"
                    android:text="@string/card_edit_06" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView
                    android:layout_marginTop="24dp"
                    style="@style/Button.Primary"
                    android:text="@string/card_edit_07"
                    android:tag="back" />
                <TextView
                    android:layout_marginTop="8dp"
                    android:textColor="@color/app_error"
                    android:background="@drawable/bg_button_danger"
                    style="@style/Button.Text"
                    android:text="@string/card_edit_08"
                    android:tag="back" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
