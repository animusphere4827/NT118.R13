<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavHost"
        android:orientation="vertical">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/review_decks_16" />
            <ImageButton
                style="@style/IconButton"
                android:src="@drawable/ic_ellipsis"
                android:tint="@color/app_text_secondary"
                android:contentDescription="@string/register_12" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp">
                    <View
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_soft" />
                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_card_big">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_layers"
                            android:tint="@color/app_primary"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                </FrameLayout>
                <TextView
                    android:textSize="22sp"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Title"
                    android:text="@string/review_empty_05" />
                <TextView
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/app_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:text="@string/review_empty_06" />
                <LinearLayout
                    android:layout_marginTop="16dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/review_empty_01" />
                    <LinearLayout
                        android:layout_marginTop="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_folder_plus"
                            android:tint="@color/app_primary"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_marginStart="10dp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColor="@color/app_text"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/review_empty_02" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_marginTop="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_bookmark"
                            android:tint="@color/app_primary"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_marginStart="10dp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColor="@color/app_text"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/review_empty_03" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_marginTop="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_calendar_check"
                            android:tint="@color/app_primary"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_marginStart="10dp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColor="@color/app_text"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/review_empty_04" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Caption"
                    android:text="@string/review_empty_07" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <LinearLayout
                    android:layout_marginTop="24dp"
                    style="@style/Button.Primary"
                    android:tag="nav:card_edit"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_plus"
                        android:tint="@color/white"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_marginStart="8dp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Body"
                        android:text="@string/review_decks_14" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/bottomNavHost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:tag="navtab:review_decks"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <include
            layout="@layout/layout_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
