<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:layout_marginStart="8dp"
                style="@style/IconButton"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/app_text_secondary"
                android:id="@+id/btnBack"
                android:tag="back"
                android:contentDescription="@string/register_13" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/badges_23" />
            <ImageButton
                style="@style/IconButton"
                android:src="@drawable/ic_info"
                android:tint="@color/app_text_secondary"
                android:contentDescription="@string/learn_path_13" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:background="@drawable/bg_panel"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:textSize="48sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.Display"
                            android:text="@string/exam_result_07" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:textStyle="bold"
                                android:gravity="end"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Text.Title"
                                android:text="@string/badges_01" />
                            <TextView
                                android:gravity="end"
                                android:layout_marginTop="2dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Text.Caption"
                                android:text="@string/badges_02" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:progress="33"
                        android:max="100"
                        app:trackThickness="6dp"
                        app:trackCornerRadius="3dp"
                        app:indicatorColor="@color/app_primary"
                        app:trackColor="@color/app_border" />
                    <TextView
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/badges_03" />
                </LinearLayout>
                <TextView
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Title"
                    android:text="@string/badges_22" />
                <LinearLayout
                    android:layout_marginTop="8dp"
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:padding="12dp"
                        android:layout_height="110dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:tag="nav:badge_congrats"
                        android:foreground="?attr/selectableItemBackground">
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_circle_soft">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_flame"
                                android:tint="@color/app_primary"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/app_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_04" />
                        <TextView
                            android:gravity="center"
                            android:textSize="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_05" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:padding="12dp"
                        android:layout_height="110dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_circle_soft">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_book_open"
                                android:tint="@color/app_primary"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/app_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_06" />
                        <TextView
                            android:gravity="center"
                            android:textSize="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_07" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:padding="12dp"
                        android:layout_height="110dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_circle_soft">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_mail"
