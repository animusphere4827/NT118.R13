                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/app_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_08" />
                        <TextView
                            android:gravity="center"
                            android:textSize="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_09" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="8dp"
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:padding="12dp"
                        android:layout_height="110dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_circle_neutral">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_lock"
                                android:tint="@color/app_text_secondary"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/app_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_10" />
                        <TextView
                            android:gravity="center"
                            android:textSize="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_11" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:padding="12dp"
                        android:layout_height="110dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_circle_neutral">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_lock"
                                android:tint="@color/app_text_secondary"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/app_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_12" />
                        <TextView
                            android:gravity="center"
                            android:textSize="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_13" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:padding="12dp"
                        android:layout_height="110dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_circle_neutral">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_lock"
                                android:tint="@color/app_text_secondary"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/app_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_14" />
                        <TextView
                            android:gravity="center"
                            android:textSize="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_15" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="8dp"
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:padding="12dp"
                        android:layout_height="110dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_circle_neutral">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_lock"
                                android:tint="@color/app_text_secondary"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/app_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_16" />
                        <TextView
                            android:gravity="center"
                            android:textSize="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_17" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:padding="12dp"
                        android:layout_height="110dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_circle_neutral">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_lock"
                                android:tint="@color/app_text_secondary"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/app_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_18" />
                        <TextView
                            android:gravity="center"
                            android:textSize="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_19" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:padding="12dp"
                        android:layout_height="110dp"
                        android:gravity="center_horizontal"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_circle_neutral">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_lock"
                                android:tint="@color/app_text_secondary"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:gravity="center"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/app_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_20" />
                        <TextView
                            android:gravity="center"
                            android:textSize="10sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.Caption"
                            android:text="@string/badges_21" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
