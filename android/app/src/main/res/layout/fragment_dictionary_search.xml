<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_start" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/guide_end" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/screenColumn"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_height="56dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:layout_marginStart="8dp"
                style="@style/IconButton"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/app_text_secondary"
                android:id="@+id/btnBack"
                android:tag="back"
                android:contentDescription="@string/register_13" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                style="@style/Text.Title"
                android:text="@string/dictionary_search_15" />
            <ImageButton
                style="@style/IconButton"
                android:src="@drawable/ic_history"
                android:tint="@color/app_text_secondary"
                android:contentDescription="@string/dictionary_search_14" />
        </LinearLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Label"
                    android:text="@string/dictionary_search_01" />
                <LinearLayout
                    android:layout_height="48dp"
                    android:background="@drawable/bg_field"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/app_text_secondary"
                        android:importantForAccessibility="no" />
                    <EditText
                        style="@style/Field.Input"
                        android:id="@+id/edtSearch"
                        android:hint="@string/dictionary_search_01"
                        android:text="@string/dictionary_search_02"
                        android:inputType="text"
                        android:imeOptions="actionSearch" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Title"
                        android:text="@string/dictionary_search_03" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Link"
                        android:text="@string/dictionary_search_04" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/Chip"
                        android:text="@string/deck_detail_08"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        style="@style/Chip"
                        android:text="@string/deck_detail_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        style="@style/Chip"
                        android:text="@string/intro2_07"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        style="@style/Text.Title"
                        android:text="@string/dictionary_search_05" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/dictionary_search_06" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:tag="nav:dictionary_detail"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:textSize="20sp"
                            android:layout_height="wrap_content"
                            style="@style/Text.Title"
                            android:text="@string/intro2_07" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_up_right"
                            android:tint="@color/app_primary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/flashcard_front_02" />
                    <TextView
                        android:layout_marginTop="2dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/dictionary_search_07" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:tag="nav:dictionary_detail"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:textSize="20sp"
                            android:layout_height="wrap_content"
                            style="@style/Text.Title"
                            android:text="@string/intro2_05" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_up_right"
                            android:tint="@color/app_primary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/dictionary_search_08" />
                    <TextView
                        android:layout_marginTop="2dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/dictionary_search_09" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:tag="nav:dictionary_detail"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:textSize="20sp"
                            android:layout_height="wrap_content"
                            style="@style/Text.Title"
                            android:text="@string/quiz_part5_02" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_up_right"
                            android:tint="@color/app_primary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/dictionary_search_10" />
                    <TextView
                        android:layout_marginTop="2dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/dictionary_search_11" />
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:tag="nav:dictionary_detail"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:fontFamily="serif"
                            android:textSize="20sp"
                            android:layout_height="wrap_content"
                            style="@style/Text.Title"
                            android:text="@string/quiz_part5_04" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_up_right"
                            android:tint="@color/app_primary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <TextView
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/dictionary_search_12" />
                    <TextView
                        android:layout_marginTop="2dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.Caption"
                        android:text="@string/dictionary_search_13" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
