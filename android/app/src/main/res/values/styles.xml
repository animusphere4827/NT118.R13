<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Chữ -->
    <style name="Text" parent="">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Heading">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Display">
        <item name="android:textSize">56sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>
    <style name="Text.Label">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>
    <style name="Text.Link">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_primary</item>
    </style>

    <!-- Nút -->
    <style name="Button" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
    <style name="Button.Outline">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/app_primary</item>
    </style>
    <style name="Button.Text">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/app_primary</item>
    </style>

    <!-- Ô nhập -->
    <style name="Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/field_height</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="Field.Input" parent="Text.Body">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@null</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColorHint">@color/app_text_secondary</item>
    </style>

    <style name="IconButton" parent="">
        <item name="android:layout_width">@dimen/icon_button</item>
        <item name="android:layout_height">@dimen/icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/app_text_secondary</item>
    </style>

    <!-- Hàng kế hoạch hôm nay -->
    <style name="PlanRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="PlanIcon" parent="">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/app_primary</item>
    </style>
    <style name="PlanText" parent="Text.Caption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textColor">@color/app_text</item>
    </style>

    <style name="NavTab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
</resources>
