# Sao chép thành local_config.properties (cùng thư mục) rồi sửa. File đó không được commit.
# Emulator: http://10.0.2.2:<port>/api/  |  Máy thật cùng Wi-Fi: http://<IP máy dev>:<port>/api/
api.baseUrl=http://10.0.2.2:3000/api/
# OAuth 2.0 Client ID loại "Web application" của Firebase project (default_web_client_id trong google-services.json)
google.webClientId=
# Google cần bật provider trong Firebase và file google-services.json; huy hiệu dùng API thật.
# forgotPassword, profileUpdate đã có API (B1.3); đặt true khi server chưa cấu hình SMTP mà vẫn muốn thử luồng OTP
fake.googleAuth=false
fake.forgotPassword=false
fake.profileUpdate=false
fake.badges=false
