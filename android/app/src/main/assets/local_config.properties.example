# Sao chép thành local_config.properties (cùng thư mục) rồi sửa. File đó không được commit.
# Emulator: http://10.0.2.2:<port>/api/  |  Máy thật cùng Wi-Fi: http://<IP máy dev>:<port>/api/
api.baseUrl=http://10.0.2.2:3000/api/
# OAuth 2.0 Client ID loại "Web application" trên Google Cloud Console
google.webClientId=
# true = dùng dữ liệu giả vì server chưa có endpoint; đổi false khi TV1 làm xong
fake.googleAuth=true
fake.forgotPassword=true
fake.profileUpdate=true
fake.badges=true
